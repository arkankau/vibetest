# Vibetest Configuration
# Copy this file to .env and fill in your API keys

# API Keys (at least one is required)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# Model Configuration
# For Anthropic models, use format: anthropic/model-name
# For OpenAI models, use format: openai/model-name
VIBETEST_MODEL=anthropic/claude-3-5-sonnet-20241022
# VIBETEST_MODEL=openai/gpt-4
# VIBETEST_MODEL=openai/gpt-4-turbo-preview

# Execution Configuration
VIBETEST_EVIDENCE_DIR=./evidence
VIBETEST_LOG_DIR=./logs

INSPECT_EVAL_MAX_CONNECTIONS=30

# Optional: Sandbox Configuration
# VIBETEST_SANDBOX=docker
