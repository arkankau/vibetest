# Meerkat configuration

# Set at least one provider key for the model you plan to use.
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Inspect model identifier, for example:
# MEERKAT_MODEL=openai/your-model
# MEERKAT_MODEL=anthropic/your-model
MEERKAT_MODEL=

MEERKAT_EVIDENCE_DIR=./evidence
MEERKAT_LOG_DIR=./logs
