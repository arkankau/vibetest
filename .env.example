# Meerkat configuration

# Set at least one provider key for the model you plan to use.
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Inspect model identifier, for example:
# VIBETEST_MODEL=openai/your-model
# VIBETEST_MODEL=anthropic/your-model
VIBETEST_MODEL=

VIBETEST_EVIDENCE_DIR=./evidence
VIBETEST_LOG_DIR=./logs
