#!/bin/bash
# Example pre-commit hook for running ruff
# To use this:
#   1. Copy to .git/hooks/pre-commit
#   2. Make executable: chmod +x .git/hooks/pre-commit

echo "Running ruff linter..."
uv run ruff check --fix .

if [ $? -ne 0 ]; then
    echo "Ruff linting failed. Please fix the issues and try again."
    exit 1
fi

echo "Running ruff formatter..."
uv run ruff format .

if [ $? -ne 0 ]; then
    echo "Ruff formatting failed. Please fix the issues and try again."
    exit 1
fi

# Add any fixed files back to the commit
git add -u

echo "Ruff checks passed!"
exit 0
