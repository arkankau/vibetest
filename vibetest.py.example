"""Example vibetest.py configuration file.

This file demonstrates how to define test cases for vibetest.
Simply rename this to 'vibetest.py' and run 'vibetest' in your project directory.
"""

from pathlib import Path
from vibetest import TestCase

# Define your test cases
tests = [
    TestCase(
        description="Training loss is logged and generally decreases during training",
        repo_path=Path("."),
    ),
    TestCase(
        description="Model saves checkpoints periodically during training",
        repo_path=Path("."),
    ),
    TestCase(
        description="Hyperparameters are logged at the start of training",
        repo_path=Path("."),
    ),
    TestCase(
        description="Test accuracy is deterministic when running evaluation multiple times",
        repo_path=Path("."),
    ),
]
